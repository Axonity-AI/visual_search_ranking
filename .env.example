# Environment Configuration for Visual Search Ranking
# Copy this file to .env and fill in your values

# Vector Database Configuration
VECTOR_DB_TYPE=pinecone

# Pinecone Configuration (for enterprise demo)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_PRODUCTS_INDEX=visual-search-products
PINECONE_ROOMS_INDEX=visual-search-rooms

# Weaviate Configuration (for local development)
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080

# Server Configuration
BACKEND_PORT=8000
STATIC_PORT=8001
