# Application Configuration
APP_NAME=Enterprise Visual Search Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:8001", "http://localhost:8002"]

# Vector Database - Pinecone (Production Demo)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_PRODUCTS_INDEX=visual-search-products
PINECONE_ROOMS_INDEX=visual-search-rooms
VECTOR_DB_TYPE=pinecone  # Options: pinecone, weaviate

# Vector Database - Weaviate (Local Development)
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_USE_LOCAL=True

# CLIP Model Configuration
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CLIP_DEVICE=cuda  # or cpu
CLIP_BATCH_SIZE=32

# Image Processing
MAX_IMAGE_SIZE=224
SUPPORTED_FORMATS=["jpg", "jpeg", "png", "webp"]
MAX_UPLOAD_SIZE_MB=10

# Search Configuration
DEFAULT_TOP_K=20
MAX_TOP_K=100

# Caching (Optional - Redis)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Performance
WORKERS=4
WORKER_TIMEOUT=120

# Dataset Paths (relative to data/)
PRODUCT_DATASET_PATH=data/raw/fashion_products
ROOM_DATASET_PATH=data/raw/ikea_interior
EMBEDDINGS_PATH=data/embeddings

# Feature Flags
ENABLE_METRICS=True
ENABLE_REAL_TIME_EMBEDDING=True
ENABLE_BATCH_PROCESSING=False
